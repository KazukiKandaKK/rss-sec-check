rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == resource.data.ownerEmail;
    }

    function isOwnerCreating(data) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == data.ownerEmail;
    }

    function isValidFeedData(data) {
      return data.keys().hasOnly(['url', 'name', 'category', 'enabled', 'ownerEmail'])
        && data.url is string
        && data.url.matches('^https?://.+')
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.category is string
        && data.category.size() <= 50
        && data.enabled is bool
        && data.ownerEmail is string
        && data.ownerEmail == request.auth.token.email;
    }

    function isValidWatchlistData(data) {
      return data.keys().hasOnly(['ownerEmail', 'keywords'])
        && data.ownerEmail is string
        && data.ownerEmail == request.auth.token.email
        && data.keywords is list
        && data.keywords.size() <= 50;
    }

    match /config/{docId} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email;
      allow list, create, update, delete: if false;
    }

    match /settings/watchlist {
      allow get: if isOwner();
      allow create: if isOwnerCreating(request.resource.data)
        && isValidWatchlistData(request.resource.data);
      allow update: if isOwner()
        && isValidWatchlistData(request.resource.data);
      allow list, delete: if false;
    }

    match /articles/{articleId} {
      allow get: if isOwner();
      allow list: if isOwner();
      allow create, delete: if false;
      allow update: if isOwner() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'starred']) &&
        request.resource.data.read is bool &&
        request.resource.data.starred is bool;
    }

    match /feeds/{feedId} {
      allow get: if isOwner();
      allow list: if isOwner();
      allow create: if isOwnerCreating(request.resource.data) && isValidFeedData(request.resource.data);
      allow delete: if isOwner();
      allow update: if isOwner() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['enabled']) &&
        request.resource.data.enabled is bool;
    }
  }
}
