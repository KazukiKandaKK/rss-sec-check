# Firebase web app config (used in web/src/lib/firebase.ts)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Owner email (must match the one in firestore.rules and the Google account)
VITE_OWNER_EMAIL=owner@example.com

# Optional cap on the number of recent articles loaded by the web client.
# Lower values reduce Firestore reads and UI memory; pagination is out of scope for now.
VITE_ARTICLES_LIMIT=1000

# Functions / emulator configuration (used in scripts)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
OWNER_EMAIL=owner@example.com

# Fetch schedule interval (used by onSchedule, default 30 minutes)
FETCH_SCHEDULE_INTERVAL=30

# Article retention: read & non-starred articles older than this many days
# (by publishedAt) are pruned on each fetch run. Set 0 to disable pruning.
ARTICLE_MAX_AGE_DAYS=90

# Optional Slack Incoming Webhook for fetch digests (Alert feeds / watchlist
# keyword hits / fetch errors). Leave unset to disable notifications.
# For GitHub Actions, set this as the SLACK_WEBHOOK_URL repository secret.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
